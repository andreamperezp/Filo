# Copiar a .env.local y completar. Nunca commitear .env.local.
# En desarrollo `npm run dev` ya carga valores de prueba desde .env.development.

# ── Sesión y acceso (obligatorias en producción) ──
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# Cuenta de la dueña para /equipo (contraseña de 10+ caracteres)
OWNER_EMAIL=
OWNER_PASSWORD=

# ── Fase 2 · Supabase ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Fase 3 · Mercado Pago (seña) ──
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# ── Fase 3 · WhatsApp Cloud API (recordatorios) ──
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
